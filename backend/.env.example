# Neon connection string (Neon console → Connect → "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/fitkey?sslmode=require

PORT=4000
NODE_ENV=development

# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
CHECKIN_SECRET=change-me-too
OTP_SECRET=change-me-three

# Time zone used for "check-in day", weekly/monthly windows, etc.
APP_TZ=Asia/Kolkata

# When true, /auth/otp/request returns the OTP in the response (dev only — no SMS provider yet)
EXPOSE_DEV_OTP=true

# mock = purchases activate instantly without payment (dev / demo). razorpay = real payments.
PAYMENTS_MODE=mock
# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Set these on the server only — never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<your-api>/api/v1/payments/webhook  · events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Phone number that `npm run seed` turns into an admin account
ADMIN_PHONE=+919999999999

# Comma-separated origins for CORS; * allows all (fine for mobile apps)
CORS_ORIGINS=*

# OpenAI key for Mansi (AI coach) and the AI meal / label scanner
OPENAI_API_KEY=
# Optional: model override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: YouTube Data API v3 key for the Studio importer (npm run import-youtube / admin "Studio import" tab).
# Without it: title, channel and thumbnail come from YouTube oEmbed; durations and playlist items are read from
# YouTube's public pages (best effort — the import report says when that fails; duration then stays unknown).
# With it: exact durations, complete playlists and embeddable/private status from the official API.
# Get one (free, 10,000 units/day — an import of ~150 videos uses ~10): https://console.cloud.google.com →
# create/select a project → APIs & Services → Library → enable "YouTube Data API v3" → Credentials →
# Create credentials → API key → (recommended) restrict the key to "YouTube Data API v3". Paste it below.
YOUTUBE_API_KEY=
